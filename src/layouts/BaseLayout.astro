---
import '../styles/global.css'
import { VisualEditing } from '@sanity/astro/visual-editing'
import { stegaClean } from '@sanity/client/stega'
import type { Layout } from '@cms/lib/types'
import { urlFor } from '@cms/lib/image'
import { applyTitleTemplate } from '@/lib/format'
import { toOpeningHoursSpec } from '@/lib/hours'
import Header from '@components/layout/Header.astro'
import Footer from '@components/layout/Footer.astro'
import Icons from '@components/ui/Icons.astro'
import type { SanityImageValue } from '@components/ui/SanityImage.astro'

interface Seo {
  metaTitle?: string | null
  metaDescription?: string | null
  canonicalUrl?: string | null
  noIndex?: boolean | null
  ogImage?: SanityImageValue | null
}

interface Props {
  layout: Layout
  /** The page's own title. The SEO meta title wins when set. */
  title?: string | null
  seo?: Seo | null
  /** Used when the page has no meta description (e.g. a post excerpt). */
  description?: string | null
  /** Used when the page has no social share image (e.g. the featured image). */
  image?: SanityImageValue | null
  type?: 'website' | 'article'
  publishedAt?: string | null
  modifiedAt?: string | null
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[]
}

const { layout, title, seo, description, image, type = 'website', publishedAt, modifiedAt, jsonLd = [] } = Astro.props
const { settings } = layout
const { draftMode } = Astro.locals

const siteName = stegaClean(settings?.siteName) || 'Ascend AI Marketing'
const defaults = settings?.defaultSeo
const rawTitle = stegaClean(seo?.metaTitle || title || defaults?.metaTitle) || ''
const pageTitle = rawTitle ? applyTitleTemplate(settings?.titleTemplate, rawTitle) : siteName
const pageDescription = stegaClean(seo?.metaDescription || description || defaults?.metaDescription) || ''
const site = Astro.site ?? new URL(Astro.url.origin)
const canonical = stegaClean(seo?.canonicalUrl) || new URL(Astro.url.pathname, site).href
const shareImage = [seo?.ogImage, image, defaults?.ogImage].find((img) => img?.asset)
const shareImageUrl = shareImage ? urlFor(shareImage as Parameters<typeof urlFor>[0]).width(1200).height(630).fit('crop').url() : null
const shareImageAlt = stegaClean(shareImage?.alt) || pageTitle
const noIndex = Boolean(seo?.noIndex) || draftMode
const favicon = settings?.faviconUrl
const tracking = draftMode ? null : settings

const address = settings?.address
const businessJsonLd = settings
  ? {
      '@context': 'https://schema.org',
      '@type': stegaClean(settings.businessType) || 'LocalBusiness',
      name: siteName,
      url: site.href,
      description: stegaClean(defaults?.metaDescription) || undefined,
      telephone: stegaClean(settings.phone) || undefined,
      email: stegaClean(settings.email) || undefined,
      priceRange: stegaClean(settings.priceRange) || undefined,
      logo: settings.logo?.asset ? urlFor(settings.logo as Parameters<typeof urlFor>[0]).width(512).url() : undefined,
      image: shareImageUrl ?? undefined,
      address: address?.street
        ? {
            '@type': 'PostalAddress',
            streetAddress: stegaClean(address.street),
            addressLocality: stegaClean(address.city) || undefined,
            addressRegion: stegaClean(address.state) || undefined,
            postalCode: stegaClean(address.zip) || undefined,
            addressCountry: 'US',
          }
        : undefined,
      hasMap: stegaClean(settings.mapUrl) || undefined,
      openingHoursSpecification: settings.hours?.length ? toOpeningHoursSpec(settings.hours) : undefined,
      sameAs: settings.socialLinks?.map((s) => stegaClean(s.url)).filter(Boolean),
    }
  : null
const structuredData = [businessJsonLd, ...jsonLd].filter(Boolean)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Turn on entrance animations before first paint, unless the visitor prefers reduced motion.
      // If the motion script never loads, show everything after 3 seconds.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
        setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('motion') }, 3000)
      }
    </script>
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && <meta property="og:image:width" content="1200" />}
    {shareImageUrl && <meta property="og:image:height" content="630" />}
    {shareImageUrl && <meta property="og:image:alt" content={shareImageAlt} />}
    {publishedAt && <meta property="article:published_time" content={stegaClean(publishedAt)} />}
    {modifiedAt && <meta property="article:modified_time" content={stegaClean(modifiedAt)} />}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}

    {
      favicon ? (
        <>
          <link rel="icon" href={`${favicon}?w=64&h=64&fit=crop`} />
          <link rel="apple-touch-icon" href={`${favicon}?w=180&h=180&fit=crop`} />
        </>
      ) : (
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wdth,wght,ROND@6..144,75..125,300..800,0..100&display=swap" />
    <meta name="theme-color" content="#11301c" />
    <link rel="sitemap" href="/sitemap.xml" />
    {tracking?.googleSiteVerification && <meta name="google-site-verification" content={stegaClean(tracking.googleSiteVerification)} />}

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      tracking?.gtmId && (
        <script is:inline define:vars={{ id: stegaClean(tracking.gtmId) }}>
          ;(function (w, d, s, l, i) {
            w[l] = w[l] || []
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
            var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''
            j.async = true
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
            f.parentNode.insertBefore(j, f)
          })(window, document, 'script', 'dataLayer', id)
        </script>
      )
    }
    {
      tracking?.gaId && !tracking.gtmId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${stegaClean(tracking.gaId)}`} />
          <script is:inline define:vars={{ id: stegaClean(tracking.gaId) }}>
            window.dataLayer = window.dataLayer || []
            function gtag() { dataLayer.push(arguments) }
            gtag('js', new Date())
            gtag('config', id)
          </script>
        </>
      )
    }
    {
      tracking?.metaPixelId && (
        <script is:inline define:vars={{ id: stegaClean(tracking.metaPixelId) }}>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', id); fbq('track', 'PageView');
        </script>
      )
    }
  </head>

  <body>
    {
      tracking?.gtmId && (
        <noscript>
          <iframe src={`https://www.googletagmanager.com/ns.html?id=${stegaClean(tracking.gtmId)}`} height="0" width="0" style="display:none;visibility:hidden" />
        </noscript>
      )
    }
    <Icons />
    <a href="#main-content" class="skip-link btn btn--primary">Skip to content</a>

    <Header layout={layout} />

    <main id="main-content">
      <slot />
    </main>

    <Footer layout={layout} />

    {
      draftMode && (
        <div class="draft-banner" id="draft-banner" hidden>
          Previewing unpublished changes. <a href={`/api/draft-mode/disable?redirect=${encodeURIComponent(Astro.url.pathname)}`}>Exit preview</a>
        </div>
      )
    }
    <VisualEditing enabled={draftMode} zIndex={1000} />
    <script>
      import '@/scripts/motion'
      ;(window as unknown as { __motionReady: boolean }).__motionReady = true
    </script>
  </body>
</html>

{
  draftMode && (
    <script is:inline>
      // Inside the Studio the Presentation tool shows its own controls, so only show the banner outside it.
      if (window.self === window.top) document.getElementById('draft-banner')?.removeAttribute('hidden')
    </script>
  )
}

<style>
  .draft-banner {
    position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); z-index: 1001;
    background: var(--color-bg-dark); color: var(--color-text-inverse);
    padding: 0.6rem 1rem; border-radius: var(--radius-full); font-size: 0.875rem;
    box-shadow: 0 10px 25px -10px rgb(0 0 0 / 0.4);
  }
  .draft-banner a { text-decoration: underline; margin-left: 0.5rem; }
</style>
