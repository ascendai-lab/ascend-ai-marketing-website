---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageBuilder from '@components/blocks/PageBuilder.astro'
import { loadQuery } from '@cms/lib/load'
import { layoutQuery, pageQuery } from '@cms/queries'

const slug = Astro.params.slug?.replace(/\/$/, '')
if (!slug) return Astro.rewrite('/404')

const { draftMode } = Astro.locals
const [layout, page] = await Promise.all([loadQuery(draftMode, layoutQuery), loadQuery(draftMode, pageQuery, { slug })])
if (!page) return Astro.rewrite('/404')

const startsWithHero = page.pageBuilder?.[0]?._type === 'hero'
---

<BaseLayout layout={layout} title={page.title} seo={page.seo}>
  {!startsWithHero && (
    <header class="section bg-muted"><div class="container"><h1 class="section-heading">{page.title}</h1></div></header>
  )}
  <PageBuilder blocks={page.pageBuilder} document={page} settings={layout.settings} firstHeroIsH1={startsWithHero} />
</BaseLayout>
