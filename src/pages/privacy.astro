---
import BaseLayout from '@layouts/BaseLayout.astro'
import Section from '@components/ui/Section.astro'
import { loadQuery } from '@cms/lib/load'
import { emptyLayout } from '@cms/lib/types'
import { layoutQuery } from '@cms/queries'
import { privacy } from '@/content/legal'

const layout = await loadQuery(Astro.locals.draftMode, layoutQuery).catch(() => emptyLayout)
const seo = { metaTitle: `Privacy policy | Ascend AI Marketing`, metaDescription: privacy.intro }
---

<BaseLayout layout={layout} seo={seo}>
  <section class="legal-hero surface-deep">
    <div class="container">
      <p class="eyebrow">Last updated {privacy.updated}</p>
      <h1 class="t-display legal-hero__h">{privacy.title}</h1>
      <p class="legal-hero__intro">{privacy.intro}</p>
    </div>
  </section>
  <Section surface="white">
    <div class="legal">
      {privacy.sections.map((section) => (
        <section>
          <h2 class="t-h4">{section.heading}</h2>
          {section.body.map((p) => <p>{p}</p>)}
        </section>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .legal-hero { padding-block: var(--space-16); }
  .legal-hero__h { font-size: var(--text-display-sm); }
  .legal-hero__intro { margin-top: var(--stack-body); font-size: var(--text-body-lg); color: var(--surface-body); max-width: 52ch; }
  .legal { display: grid; gap: var(--space-10); max-width: var(--measure); }
  .legal section { display: grid; gap: var(--space-3); }
  .legal p { font-size: var(--text-body-lg); line-height: 1.65; color: var(--surface-body); }
</style>
