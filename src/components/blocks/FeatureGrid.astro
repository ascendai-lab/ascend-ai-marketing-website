---
import { stegaClean } from '@sanity/client/stega'
import type { BlockOf } from '@cms/lib/types'
import { resolveLink } from '@cms/lib/links'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import SanityImage from '@components/ui/SanityImage.astro'

interface Props {
  block: BlockOf<'featureGrid'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const columns = stegaClean(block.columns) ?? 3
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} />
  <div class="grid-cards" data-columns={columns}>
    {
      block.items?.map((item) => {
        const link = resolveLink(item.link)
        return (
          <article class="card feature">
            {item.image?.asset && <SanityImage image={item.image} width={96} class="feature__icon" />}
            <h3 class="feature__title">{item.title}</h3>
            {item.description && <p>{item.description}</p>}
            {link && (
              <a href={link.href} target={link.target} rel={link.rel} class="btn btn--ghost">
                Learn more
              </a>
            )}
          </article>
        )
      })
    }
  </div>
</Section>

<style>
  .feature { padding: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .feature :global(.feature__icon) { width: 3.5rem; height: 3.5rem; object-fit: contain; }
  .feature__title { font-size: 1.25rem; }
  .feature .btn { margin-top: auto; align-self: flex-start; }
</style>
