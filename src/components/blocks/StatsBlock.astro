---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'

interface Props {
  block: BlockOf<'statsBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} />
  <dl class="stats">
    {
      block.items?.map((item) => (
        <div class="stat">
          <dt class="stat__label">{item.label}</dt>
          <dd class="stat__value">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .stats { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); text-align: center; }
  .stat { display: flex; flex-direction: column-reverse; gap: 0.25rem; }
  .stat__value { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; }
  .stat__label { opacity: 0.8; }
</style>
