---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import SanityImage from '@components/ui/SanityImage.astro'

interface Props {
  block: BlockOf<'teamBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const items = (block.items ?? []).filter((item) => item !== null)
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} />
  <div class="grid-cards" data-columns="3">
    {
      items.map((member) => (
        <article class="card member">
          {member.photo?.asset && <SanityImage image={member.photo} width={400} aspectRatio={1} />}
          <div class="member__body">
            <h3>{member.name}</h3>
            {member.role && <p class="member__role">{member.role}</p>}
            {member.bio && <p>{member.bio}</p>}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .member :global(img) { width: 100%; }
  .member__body { padding: 1.5rem; display: grid; gap: 0.5rem; }
  .member__role { color: var(--color-brand); font-weight: 600; }
</style>
