---
import type { Layout } from '@cms/lib/types'
import { resolveLink } from '@cms/lib/links'
import { routes } from '@cms/routes'
import SocialIcon from '@components/ui/SocialIcon.astro'
import SanityImage from '@components/ui/SanityImage.astro'
import ContactDetails from './ContactDetails.astro'
import { stegaClean } from '@sanity/client/stega'

interface Props {
  layout: Layout
}

const { settings, navigation, footerPages } = Astro.props.layout
const year = new Date().getFullYear()
const copyright = settings?.copyrightName || settings?.siteName
const footerLogo = settings?.logoInverse?.asset ? settings.logoInverse : settings?.logo
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      {footerLogo?.asset ? <SanityImage image={footerLogo} width={180} sizes="180px" /> : <strong>{settings?.siteName}</strong>}
      {settings?.footerText && <p>{settings.footerText}</p>}
      {
        settings?.socialLinks?.length ? (
          <ul class="site-footer__social">
            {settings.socialLinks.map((social) => (
              <li>
                <a href={stegaClean(social.url) ?? '#'} target="_blank" rel="noopener noreferrer" aria-label={stegaClean(social.platform) ?? 'Social profile'}>
                  <SocialIcon platform={social.platform} />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>

    {
      navigation?.footerColumns?.map((column) => (
        <nav aria-label={column.heading ?? 'Footer'}>
          {column.heading && <h2 class="site-footer__heading">{column.heading}</h2>}
          <ul>
            {column.links?.map((item) => {
              const link = resolveLink(item.link)
              return link ? (
                <li>
                  <a href={link.href} target={link.target} rel={link.rel}>
                    {item.label}
                  </a>
                </li>
              ) : null
            })}
          </ul>
        </nav>
      ))
    }

    {settings && <ContactDetails settings={settings} />}
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {copyright}. All rights reserved.</p>
    {
      footerPages.length > 0 && (
        <ul>
          {footerPages.map((page) => page.slug && (
            <li>
              <a href={routes.page(page.slug)}>{page.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .site-footer { background: var(--color-bg-dark); color: var(--color-text-inverse); padding-top: 4rem; }
  .site-footer p { color: inherit; opacity: 0.8; }
  .site-footer__grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); padding-bottom: 3rem; }
  .site-footer__brand { display: grid; gap: 1rem; align-content: start; }
  .site-footer__brand :global(img) { max-height: 3rem; width: auto; }
  .site-footer__heading { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; opacity: 0.75; }
  .site-footer ul { list-style: none; display: grid; gap: 0.5rem; }
  .site-footer a:hover { text-decoration: underline; }
  .site-footer__social { display: flex !important; gap: 0.75rem; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; padding-block: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.15); font-size: 0.875rem; }
  .site-footer__bottom ul { display: flex; flex-wrap: wrap; gap: 1.25rem; }
</style>
