---
/** What's at stake: one short, centered statement on deep green, and the quiz button. */
import Section from '@components/ui/Section.astro'
import Btn from '@components/ui/Btn.astro'
import { links, hero } from '@/content/home'
import type { ServiceSectionCopy } from '@/content/services'

interface Props {
  section: ServiceSectionCopy
}

const { section } = Astro.props
const paragraphs = section.blocks.flatMap((b) => (b.type === 'p' ? [b.text] : []))
---

<Section surface="deep">
  <div class="stakes" data-reveal>
    <h2 class="t-h2">{section.heading}</h2>
    {paragraphs.map((p) => <p class="body-lg">{p}</p>)}
    <div class="actions"><Btn href={links.quiz} icon="arrow">{hero.primary}</Btn></div>
  </div>
</Section>

<style>
  .stakes { display: grid; justify-items: center; text-align: center; gap: var(--stack-body); max-width: 48rem; margin-inline: auto; }
  .stakes .t-h2, .stakes .body-lg { margin-inline: auto; }
  .stakes .actions { margin-top: var(--space-2); justify-content: center; }
</style>
