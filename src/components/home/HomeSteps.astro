---
import { twoDigit } from '@/lib/format'
import Section from '@components/ui/Section.astro'
import SectionHead from '@components/ui/SectionHead.astro'
import Btn from '@components/ui/Btn.astro'
import Icon from '@components/ui/Icon.astro'
import { steps, inbox, links, hero } from '@/content/home'
---

<Section surface="deeper" anchorId="steps">
  <SectionHead eyebrow={steps.eyebrow} heading={steps.heading} intro={steps.note} align="split" />
  <div class="split split--top steps">
    <ol class="steps__list">
      {steps.items.map((step, i) => (
        <li>
          <div class="steps__head"><span class="icon-chip"><Icon name={step.icon} /></span><h3 class="t-h3">{step.title}</h3><span class="steps__num">{twoDigit(i)}</span></div>
          <p>{step.text}</p>
          {i === 0 && <div class="steps__cta"><Btn href={links.quiz} icon="arrow">{hero.primary}</Btn></div>}
        </li>
      ))}
    </ol>
    <figure class="media steps__scene">
      <img src={steps.photo.src} alt={steps.photo.alt} width="1600" height="1200" loading="lazy" />
      <div class="ui-panel steps__inbox">
        <p class="steps__inbox-title"><Icon name="inbox" />One inbox for every lead</p>
        <ul>
          {inbox.map((row) => (
            <li class="ui-row"><span class="avatar">{row.initials}</span><div><strong>{row.title}</strong><span>{row.detail}</span></div><em class={`status status--${row.tone}`}>{row.status}</em></li>
          ))}
        </ul>
      </div>
    </figure>
  </div>
</Section>

<style>
  .steps { padding-top: var(--space-12); border-top: 1px solid var(--surface-line); }
  .steps__list li { padding-block: var(--space-6); border-bottom: 1px solid var(--surface-line); }
  .steps__list li:first-child { padding-top: 0; }
  .steps__head { display: flex; align-items: center; gap: var(--space-4); }
  .steps__head h3 { flex: 1; }
  .steps__num { font-size: var(--text-sm); color: var(--surface-muted); letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }
  .steps__list p, .steps__cta { margin: var(--space-4) 0 0 calc(var(--icon-chip) + var(--space-4)); }
  .steps__list p { font-size: var(--text-body); }
  .steps__cta { margin-top: var(--space-6); }
  .steps__scene { margin: 0; min-height: 32rem; display: flex; align-items: flex-end; justify-content: center; padding: var(--space-6); }
  .steps__scene > img { position: absolute; inset: 0; }
  .steps__inbox { position: relative; width: min(25rem, 100%); padding: var(--space-4); box-shadow: var(--shadow-lg); }
  .steps__inbox-title { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-ui); font-weight: var(--weight-strong); color: var(--color-text); }
  .steps__inbox-title :global(.icon) { color: var(--color-brand); }
  .steps__inbox ul { display: grid; gap: 0.375rem; }
  .steps__inbox li { padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-muted); }
  @media (max-width: 640px) {
    .steps__list p, .steps__cta { margin-left: 0; }
    .steps__scene { min-height: 0; padding: 11rem var(--space-4) var(--space-4); }
    .steps__inbox .status { display: none; }
  }
</style>
