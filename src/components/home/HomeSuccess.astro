---
import Section from '@components/ui/Section.astro'
import Icon from '@components/ui/Icon.astro'
import { success } from '@/content/home'
---

<Section surface="white">
  <div class="split">
    <figure class="media success__photo">
      <img src={success.photo.src} alt={success.photo.alt} width="1400" height="1100" loading="lazy" />
      <ul class="success__notes">
        {success.notes.map((note) => (
          <li class="float-note"><span class="icon-chip icon-chip--ui"><Icon name={note.icon} /></span><div><strong>{note.title}</strong><span>{note.text}</span></div></li>
        ))}
      </ul>
    </figure>
    <div>
      <p class="eyebrow">{success.eyebrow}</p>
      <h2 class="t-h2">{success.heading}</h2>
      <div class="success__body">{success.body.map((p) => <p class="body-lg">{p}</p>)}</div>
      <p class="lead strong success__close">{success.close}</p>
    </div>
  </div>
</Section>

<style>
  .success__photo { margin: 0; aspect-ratio: 1 / 1; max-width: 36rem; }
  .success__notes { position: absolute; left: var(--space-5); right: var(--space-5); bottom: var(--space-5); display: grid; gap: var(--space-2); justify-items: start; }
  .success__notes li:nth-child(2) { margin-left: var(--space-6); }
  .success__notes li:nth-child(3) { margin-left: var(--space-12); }
  .success__body { margin-top: var(--space-6); }
  .success__close { margin-top: var(--space-6); font-weight: var(--weight-medium); max-width: 36ch; }
  @media (max-width: 640px) { .success__notes li:nth-child(n) { margin-left: 0; } }
</style>
