---
/**
 * Cookie consent. Google Analytics, Google Tag Manager and the Meta Pixel load only after the visitor
 * clicks Accept. The choice is kept in this browser (localStorage) and can be changed any time with a
 * "Cookie settings" button (any element with data-cookie-settings, e.g. in the footer).
 * Rendered only when at least one tag ID is set in the Studio (SEO & tracking): without one, the
 * site sets no tracking cookies and there is nothing to ask about.
 */
import { COOKIES_PATH, cookieBanner } from '@/content/legal'

interface Props {
  gtmId?: string
  gaId?: string
  metaPixelId?: string
}

const { gtmId = '', gaId = '', metaPixelId = '' } = Astro.props
---

<div class="cookie-banner" data-cookie-banner role="region" aria-label="Cookie choices" hidden>
  <p class="cookie-banner__text">{cookieBanner.text} <a href={COOKIES_PATH}>{cookieBanner.link}</a>.</p>
  <div class="cookie-banner__actions">
    <button type="button" class="btn btn--secondary btn--sm" data-cookie-choice="declined">{cookieBanner.decline}</button>
    <button type="button" class="btn btn--primary btn--sm" data-cookie-choice="accepted">{cookieBanner.accept}</button>
  </div>
</div>

<script is:inline define:vars={{ gtmId, gaId, metaPixelId }}>
  ;(function () {
    var KEY = 'ascend-cookie-consent'
    var banner = document.querySelector('[data-cookie-banner]')
    var loaded = false
    function read() { try { return localStorage.getItem(KEY) } catch (e) { return null } }
    function save(value) { try { localStorage.setItem(KEY, value) } catch (e) { /* the choice lasts this page only */ } }
    function addScript(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s) }
    function loadTags() {
      if (loaded) return
      loaded = true
      window.dataLayer = window.dataLayer || []
      if (gtmId) {
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        addScript('https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId))
      } else if (gaId) {
        window.gtag = function () { window.dataLayer.push(arguments) }
        window.gtag('js', new Date())
        window.gtag('config', gaId)
        addScript('https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId))
      }
      if (metaPixelId) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', metaPixelId); window.fbq('track', 'PageView')
      }
    }
    function show() { banner.hidden = false }
    function hide() { banner.hidden = true }
    var choice = read()
    // A Global Privacy Control signal counts as "Decline" until the visitor accepts in Cookie settings.
    if (!choice && navigator.globalPrivacyControl === true) choice = 'declined'
    if (choice === 'accepted') loadTags()
    else if (choice !== 'declined') show()
    banner.addEventListener('click', function (event) {
      var button = event.target.closest('[data-cookie-choice]')
      if (!button) return
      var value = button.getAttribute('data-cookie-choice')
      var wasAccepted = read() === 'accepted'
      save(value)
      hide()
      if (value === 'accepted') loadTags()
      // Tags that already ran can't be unloaded: a reload stops them after "Decline".
      else if (wasAccepted && loaded) location.reload()
    })
    document.addEventListener('click', function (event) {
      if (event.target.closest && event.target.closest('[data-cookie-settings]')) { show(); banner.querySelector('button').focus() }
    })
    document.querySelectorAll('[data-cookie-settings]').forEach(function (el) { el.hidden = false })
  })()
</script>

<style>
  .cookie-banner {
    position: fixed; z-index: 60; inset-inline: var(--space-4); bottom: var(--space-4);
    max-width: 40rem; margin-inline: auto; padding: var(--space-5) var(--space-6);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4);
    background: var(--color-white); color: var(--color-text); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner__text { flex: 1 1 18rem; font-size: var(--text-sm); line-height: 1.55; }
  .cookie-banner__text a { text-decoration: underline; }
  .cookie-banner__actions { display: flex; gap: var(--space-3); }
  @media (max-width: 640px) { .cookie-banner__actions { flex: 1 1 100%; } .cookie-banner__actions .btn { flex: 1; } }
</style>
