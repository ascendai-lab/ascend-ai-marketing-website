---
/**
 * A play button that opens a YouTube or Vimeo video in a pop-up player on the page.
 * With no `url` yet, the pop-up says the video is coming and offers `fallbackHref` instead.
 * The player only loads when opened, and stops when closed.
 */
import Icon from './Icon.astro'
import { getEmbedUrl } from '@/lib/video'

interface Props {
  url?: string
  label: string
  title: string
  fallbackHref: string
  fallbackLabel: string
}

const { url, label, title, fallbackHref, fallbackLabel } = Astro.props
const embed = getEmbedUrl(url)
const src = embed ? `${embed}${embed.includes('?') ? '&' : '?'}autoplay=1&rel=0&playsinline=1` : ''
---

<div class="video-btn" data-video>
  <button type="button" class="btn btn--secondary video-btn__open" data-video-open aria-haspopup="dialog">
    <span class="video-btn__play" aria-hidden="true"><Icon name="play" fill /></span>
    <span>{label}</span>
  </button>

  <dialog class="video-modal" aria-label={title} data-video-dialog>
    <div class="video-modal__inner">
      <button type="button" class="video-modal__close" data-video-close aria-label={src ? 'Close video' : 'Close'}><Icon name="x" /></button>
      {
        src ? (
          <div class="video-modal__frame">
            <iframe title={title} data-src={src} allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen loading="lazy" />
          </div>
        ) : (
          <div class="video-modal__soon surface-deep">
            <p class="t-h3">Our video is coming soon.</p>
            <p>In the meantime, we're happy to walk you through it ourselves.</p>
            <a class="btn btn--primary" href={fallbackHref}><span>{fallbackLabel}</span><Icon name="arrow" /></a>
          </div>
        )
      }
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-video-dialog]')
    const frame = root.querySelector<HTMLIFrameElement>('iframe[data-src]')
    if (!dialog) return
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let closing = false
    // Closing fades the player and the dark backdrop out together, then closes the dialog.
    const close = () => {
      if (closing || !dialog.open) return
      if (reduce) { dialog.close(); return }
      closing = true
      dialog.classList.add('is-closing')
      dialog.animate([{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.96)' }], { duration: 220, easing: 'ease-in' })
        .finished.then(() => { dialog.close(); dialog.classList.remove('is-closing'); closing = false })
    }
    // Escape uses the same fade.
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); close() })
    root.querySelector('[data-video-open]')?.addEventListener('click', () => {
      if (frame?.dataset.src) frame.src = frame.dataset.src
      dialog.showModal()
      document.documentElement.classList.add('menu-open')
    })
    root.querySelector('[data-video-close]')?.addEventListener('click', close)
    // Clicking the dark area around the player closes it.
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close() })
    // Closing (button, Escape or backdrop) stops the video.
    dialog.addEventListener('close', () => {
      if (frame) frame.src = 'about:blank'
      document.documentElement.classList.remove('menu-open')
    })
  })
</script>

<style>
  .video-btn__open { padding-left: var(--space-2); }
  .video-btn__play {
    width: 2.25rem; height: 2.25rem; border-radius: var(--radius-full); display: grid; place-items: center;
    background: var(--btn-bg, var(--color-brand-deep)); color: var(--btn-fg, var(--color-white));
    transition: transform var(--dur-base) var(--ease-out);
  }
  .video-btn__play :global(.icon) { width: 0.875rem; height: 0.875rem; margin-left: 2px; }
  .video-btn__open:hover .video-btn__play { transform: scale(1.1); }
  .video-btn__open:hover :global(.video-btn__play .icon) { transform: none; }

  .video-modal { margin: auto; inset: 0; max-height: none; width: min(64rem, calc(100vw - 2 * var(--container-padding-x))); max-width: none; padding: var(--space-16) 0 0; border: 0; background: transparent; overflow: visible; }
  .video-modal::backdrop { background: var(--color-overlay); }
  .video-modal[open]::backdrop { animation: backdrop-in var(--dur-base) var(--ease-out); }
  .video-modal.is-closing::backdrop { opacity: 0; transition: opacity 220ms ease-in; }
  @keyframes backdrop-in { from { opacity: 0; } }
  .video-modal[open] { animation: video-in var(--dur-base) var(--ease-out); }
  @keyframes video-in { from { opacity: 0; transform: scale(0.96); } }
  .video-modal__inner { position: relative; }
  .video-modal__frame { aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-green-950); box-shadow: var(--shadow-lg); }
  .video-modal__frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .video-modal__close {
    position: absolute; top: calc(var(--icon-chip) * -1 - var(--space-3)); right: 0; z-index: 1;
    width: var(--icon-chip); height: var(--icon-chip); border: 0; border-radius: var(--radius-full);
    display: grid; place-items: center; background: var(--color-white); color: var(--color-text); cursor: pointer;
  }
  .video-modal__close :global(.icon) { width: var(--icon-size); height: var(--icon-size); }
  .video-modal__soon { box-shadow: var(--shadow-lg); border-radius: var(--radius-lg); padding: clamp(var(--space-8), 6vw, var(--space-16)); display: grid; gap: var(--space-4); justify-items: start; }
  .video-modal__soon .btn { margin-top: var(--space-4); }
  @media (max-width: 640px) { .video-btn { flex: 1 1 100%; } .video-btn__open { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .video-modal[open], .video-modal[open]::backdrop { animation: none; } }
</style>
