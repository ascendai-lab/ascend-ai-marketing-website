---
/**
 * One layout for every legal page (privacy policy, terms): a centered hero, then a centered
 * reading column. The text inside stays left-aligned so long paragraphs are easy to read.
 */
import BaseLayout from '@layouts/BaseLayout.astro'
import Section from '@components/ui/Section.astro'
import { loadQuery } from '@cms/lib/load'
import { emptyLayout } from '@cms/lib/types'
import { layoutQuery } from '@cms/queries'
import type { LegalPage } from '@/content/legal'

interface Props {
  page: LegalPage
  path: string
  /** A short description for search results when the page has no intro. */
  description?: string
}

const { page, path, description } = Astro.props
const layout = await loadQuery(Astro.locals.draftMode, layoutQuery).catch(() => emptyLayout)
const origin = Astro.site ?? new URL(Astro.url.origin)
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: page.title, item: new URL(path, origin).href },
  ],
}]
const seo = { metaTitle: `${page.title} | Ascend AI Marketing`, metaDescription: page.intro || description }
---

<BaseLayout layout={layout} seo={seo} jsonLd={jsonLd}>
  <section class="legal-hero surface-deep">
    <div class="container legal-hero__inner">
      {page.updated && <p class="legal-hero__updated">Last updated {page.updated}</p>}
      <h1 class="t-display legal-hero__h">{page.title}</h1>
      {page.intro && <p class="legal-hero__intro">{page.intro}</p>}
    </div>
  </section>
  <Section surface="white">
    <div class="legal">
      {page.sections.map((section) => (
        <section>
          <h2 class="t-h4">{section.heading}</h2>
          {section.body.map((p) => <p>{p}</p>)}
          {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
          {section.after?.map((p) => <p>{p}</p>)}
        </section>
      ))}
      <slot />
    </div>
  </Section>
</BaseLayout>

<style>
  .legal-hero { padding-block: var(--space-16); }
  .legal-hero__inner { text-align: center; }
  .legal-hero__updated { font-size: var(--text-sm); color: var(--surface-muted); margin-bottom: var(--space-4); }
  .legal-hero__h { font-size: var(--text-display-sm); margin-inline: auto; }
  .legal-hero__intro { margin: var(--stack-body) auto 0; font-size: var(--text-body-lg); color: var(--surface-body); max-width: calc(52 * var(--ch)); }
  .legal { display: grid; gap: var(--space-10); max-width: var(--measure); margin-inline: auto; }
  .legal section { display: grid; gap: var(--space-3); }
  .legal p, .legal li { font-size: var(--text-body-lg); line-height: 1.65; color: var(--surface-body); }
  .legal ul { display: grid; gap: var(--space-2); padding-left: 1.25em; list-style: disc; }
</style>
