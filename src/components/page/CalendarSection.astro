---
/**
 * "Pick a time": the GoHighLevel booking calendar (PUBLIC_GHL_CALENDAR_URL), with the call-in line,
 * the quiz tip and the teardown option beside it. Without a calendar link, a short call request form
 * stands in, so the page never shows an empty box.
 */
import Section from '@components/ui/Section.astro'
import Btn from '@components/ui/Btn.astro'
import Icon from '@components/ui/Icon.astro'
import BookingCalendar from '@components/ui/BookingCalendar.astro'
import { links, hero } from '@/content/home'
import type { ServiceSectionCopy } from '@/content/services'

interface Props {
  section: ServiceSectionCopy
  phone?: string
  surface: 'cream' | 'white'
}

const { section, phone, surface } = Astro.props
const fields = section.fields ?? {}
const callLine = fields['Under the calendar']
const notReady = fields['Not ready to book?']
const tel = phone?.replace(/[^\d+]/g, '')
---

<Section surface={surface} anchorId="calendar">
  <div class="split split--top cal">
    <div class="cal__side" data-reveal>
      <p class="eyebrow">{section.label}</p>
      <h2 class="t-h2">{section.heading}</h2>
      {fields['Tip line'] && (
        <p class="card cal__tip"><Icon name="zap" /><span>{fields['Tip line']} <a class="link" href={links.quiz}>{hero.primary}</a></span></p>
      )}
      {callLine && phone && (
        <p class="cal__call"><Icon name="phone" /><span>{callLine.replace(/\s*\[BUSINESS PHONE\]/, '')} <a class="link" href={`tel:${tel}`}>{phone}</a></span></p>
      )}
      {notReady && (
        <div class="cal__later">
          <p class="t-h4">Not ready to book?</p>
          <p>{notReady}</p>
          <Btn href={links.teardown} variant="link" icon="arrow-ur">Get a free video teardown</Btn>
        </div>
      )}
    </div>
    <div data-reveal><BookingCalendar id="book-calendar" /></div>
  </div>
</Section>

<style>
  .cal__side { display: grid; gap: var(--space-5); align-content: start; }
  .cal__tip { display: flex; gap: var(--space-3); align-items: flex-start; font-size: var(--text-body); color: var(--surface-fg); background: var(--color-sage-100); }
  .cal__tip :global(.icon), .cal__call :global(.icon) { width: var(--icon-size); height: var(--icon-size); color: var(--color-brand); flex: none; margin-top: 0.15rem; }
  .cal__call { display: flex; gap: var(--space-3); font-size: var(--text-body); }
  .cal__later { display: grid; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--surface-line); }
  .cal__later p:not(.t-h4) { color: var(--surface-muted); }
  .cal__later :global(.link) { justify-self: start; }
</style>
