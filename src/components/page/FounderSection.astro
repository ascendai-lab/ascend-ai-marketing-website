---
/** "Meet our founder" (about page): Mark's photo beside his story, the founder quote and where he's based. */
import Section from '@components/ui/Section.astro'
import Icon from '@components/ui/Icon.astro'
import { about } from '@/content/home'
import type { ServiceSectionCopy } from '@/content/services'

interface Props {
  section: ServiceSectionCopy
  surface: 'cream' | 'white'
}

const { section, surface } = Astro.props
const fields = section.fields ?? {}
const unquote = (text = '') => text.replace(/^"|"$/g, '')
const quote = (fields['Founder quote'] ?? '').match(/^"(.+)"\s*(.*)$/)
const paragraphs = section.blocks.flatMap((b) => (b.type === 'p' ? [b.text] : []))
---

<Section surface={surface} anchorId="founder">
  <div class="split founder">
    <figure class="media founder__photo">
      <img src={about.photo.src} alt={about.photo.alt} width="1200" height="1400" loading="lazy" />
    </figure>
    <div class="founder__copy" data-reveal>
      <p class="eyebrow">{section.label}</p>
      <h2 class="t-h2">{section.heading}</h2>
      {fields["Mark's story"] && <blockquote class="founder__story"><p>"{unquote(fields["Mark's story"])}"</p></blockquote>}
      {paragraphs.map((p) => <p class="body-lg">{p}</p>)}
      {quote && (
        <figure class="card founder__quote">
          <blockquote><p>"{quote[1]}"</p></blockquote>
          <figcaption>{quote[2]}</figcaption>
        </figure>
      )}
      {fields['Giving back'] && <p class="body-lg"><strong>Giving back.</strong> {fields['Giving back']}</p>}
      {fields['Home base line'] && <p class="founder__base"><Icon name="pin" />{fields['Home base line']}</p>}
    </div>
  </div>
</Section>

<style>
  .founder { align-items: start; }
  .founder__photo { margin: 0; aspect-ratio: 5 / 6; width: 100%; }
  @media (max-width: 959px) and (min-width: 641px) { .founder__photo { aspect-ratio: 4 / 3; } }
  .founder__copy { display: grid; gap: var(--space-5); }
  .founder__copy .t-h2 { margin-bottom: var(--space-1); }
  .founder__copy .body-lg { margin: 0; }
  .founder__copy strong { color: var(--surface-fg); font-weight: var(--weight-strong); }
  .founder__story p { font-size: var(--text-h4); line-height: 1.45; letter-spacing: -0.01em; color: var(--surface-fg); }
  .founder__quote { display: grid; gap: var(--space-3); }
  .founder__quote p { font-size: var(--text-body-lg); font-style: italic; color: var(--surface-body); }
  .founder__quote figcaption { font-size: var(--text-sm); font-weight: var(--weight-strong); color: var(--surface-fg); }
  .founder__base { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-body); color: var(--surface-muted); }
  .founder__base :global(.icon) { width: var(--icon-size); height: var(--icon-size); color: var(--color-brand); flex: none; }
  @media (min-width: 960px) { .founder__photo { position: sticky; top: calc(var(--header-h) + var(--space-8)); } }
</style>
