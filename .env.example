# ─── Site ────────────────────────────────────────────────────────────────────
# The production URL of the site (no trailing slash). Used for canonical URLs,
# the sitemap and social share links.
SITE_URL=https://yourclientsite.com

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Found in sanity.io/manage under your project
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# API token — create a "Viewer" token in sanity.io/manage → API → Tokens.
# Server-side only. Required for visual editing / draft previews.
SANITY_API_READ_TOKEN=your_read_token_here

# Optional — only if you ALSO deploy the Studio separately (npm run sanity:deploy):
# SANITY_STUDIO_URL=https://your-studio.sanity.studio      # where overlays link to
# SANITY_STUDIO_PREVIEW_ORIGIN=https://yourclientsite.com   # site the hosted Studio previews
# SANITY_STUDIO_PROJECT_ID=your_project_id                  # the hosted Studio reads these names
# SANITY_STUDIO_DATASET=production

# ─── Forms → LeadLine (GoHighLevel) ─────────────────────────────────────────
# The URL of a LeadLine workflow's "Inbound Webhook" trigger (Automation → Workflows → new workflow →
# trigger "Inbound Webhook" → copy the URL). Every form on the site posts its lead there.
LEADLINE_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-location-id/webhook-trigger/your-trigger-id

# ─── Booking calendar ────────────────────────────────────────────────────────
# The GoHighLevel calendar's embed link (Calendars → Share → the iframe src), e.g.
# https://api.leadconnectorhq.com/widget/booking/abc123. Shown on /book and the quiz results page.
# Without it, those pages show a short call request form that goes to LeadLine instead.
# Set the calendar's redirect (after booking) to https://<site>/book/confirmed.
PUBLIC_GHL_CALENDAR_URL=
