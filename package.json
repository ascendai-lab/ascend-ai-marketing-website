    "@sanity/visual-editing": "^6.2.0",
    "astro": "^5.18.2",
    "groq": "^6.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "sanity": "^6.21.0",
